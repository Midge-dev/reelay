<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash spec §6: the window is Reelay's canvas from the moment the
         process starts, so there is no seam before the Flutter splash's
         first frame. Dark parent regardless of the OS dark-mode setting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/reelay_canvas</item>
    </style>
    <!-- Behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/reelay_canvas</item>
    </style>
</resources>
